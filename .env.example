# ============================================================
# Colbie — Louisiana Mobile Homes Slack Bot
# Copy this file to .env for local development.
# In Railway, set these in the service's Variables tab.
# ============================================================

# Slack App credentials
# https://api.slack.com/apps → Your App → Basic Information
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# Anthropic API key
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Slack channel where daily 8 AM listings are posted.
# Use the channel name (e.g. #mobile-homes) or the channel ID (e.g. C1234567890).
# The bot must be a member of this channel.
SLACK_LISTINGS_CHANNEL=#mobile-homes

# Log level: DEBUG | INFO | WARNING | ERROR  (default: INFO)
LOG_LEVEL=INFO

# ---- NOTE ----
# Railway automatically injects PORT — do NOT set it here.
# ---- NOTE ----
